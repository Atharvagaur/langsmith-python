#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

export DEFER_PYDANTIC_BUILD=false

# integration_tests / evaluation / external need a live deployment and API keys.
TEST=${TEST:-"tests --ignore=tests/integration_tests --ignore=tests/evaluation --ignore=tests/external"}

echo "==> Running tests"
# shellcheck disable=SC2086
env \
  -u LANGCHAIN_PROJECT -u LANGCHAIN_API_KEY -u LANGCHAIN_TRACING_V2 -u LANGSMITH_TRACING \
  PYTHONDEVMODE=1 PYTHONASYNCIODEBUG=1 PYTHONPATH=tests/httpx2_alias \
  uv run python -m pytest --disable-socket --allow-unix-socket -n auto --durations=10 $TEST "$@"
